---
const { f } = Astro.props;
const list = (f.tv_airings || []).filter((a) => a.channel);
const channels = [...new Set(list.map((a) => a.channel))];
const link = f.work_id && Number(f.work_id) > 0 ? `https://elcinema.com/work/${Number(f.work_id)}/tvguide` : '';
---
{channels.length > 0 && <div class="box"><h2>أين يُعرض</h2>
  <p class="img-cap" style="margin:0 0 10px">يُعرض العمل على:</p>
  {channels.map((ch) => <div class="air"><b>{ch}</b></div>)}
  <p class="img-cap">القنوات بحسب آخر تحديث لبياناتنا. تختلف مواعيد العرض حسب بلدك وتتغير باستمرار، لذلك لا نعرض ساعات محددة هنا{link ? <>؛ تجد جدول المواعيد الحالي في <a href={link} target="_blank" rel="nofollow noopener noreferrer" style="color:var(--sig)">دليل القنوات</a></> : ''}.</p></div>}
