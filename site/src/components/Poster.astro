---
import { num } from '../lib/data.js';
const { s, eager = false, alt = '' } = Astro.props;
const f = s.facts;
const th = s.image && !s.art && /^\/media\/posters\/[^/]+\.jpg$/.test(s.image) && !s.image.endsWith('-s.jpg') ? s.image.replace(/\.jpg$/, '-s.jpg') : null;
---
<div class={s.image ? (s.art ? 'poster has-img art' : 'poster has-img') : 'poster'} style={`--h:${s.hue}`} aria-hidden={alt ? undefined : 'true'}>
  {s.image && <img class="p-img" src={th || s.image} srcset={th ? `${th} 360w, ${s.image} 600w` : undefined} sizes={th ? '(max-width: 900px) 46vw, 230px' : undefined} alt={alt} width="540" height="805" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />}
  <span class="p-count">{s.isFilm ? 'فيلم' : s.upcoming ? 'رمضان ' + f.year : s.count ? num(s.count) + (s.count === 1 ? ' حلقة' : ' حلقات') : 'مسلسل'}</span>
  <span class="p-title">{s.title}</span>
  <span class="p-year">{f.year || ''}</span>
</div>
