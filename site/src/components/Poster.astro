---
import { num } from '../lib/data.js';
const { s } = Astro.props;
const f = s.facts;
---
<div class="poster" style={`--h:${s.hue}`} aria-hidden="true">
  <span class="p-count">{num(s.count)} {s.count === 1 ? 'حلقة' : 'حلقات'}</span>
  <span class="p-title">{s.title}</span>
  <span class="p-year">{f.year || ''}</span>
</div>
