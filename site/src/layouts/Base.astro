---
import '@fontsource/noto-kufi-arabic/arabic-600.css';
import '@fontsource/noto-kufi-arabic/arabic-700.css';
import '@fontsource/noto-kufi-arabic/arabic-800.css';
import '@fontsource/noto-kufi-arabic/latin-800.css';
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import '@fontsource/noto-naskh-arabic/arabic-600.css';
import '../styles/site.css';
import { SITE_NAME, SITE_TAGLINE, DISCLOSURE } from '../config.js';
import { load, trending } from '../lib/data.js';
const LD = load();
const footSeries = LD.live.slice(0, 6);
const hasUp = LD.upcoming.length > 0;
const hasFilms = LD.films.length > 0;
const TR = trending();
const { title, description = SITE_TAGLINE, path = '/', schema = [], noindex = false, type = 'website', active = '', image = '', published = '', modified = '' } = Astro.props;
const imgUrl = new URL(image || '/og-default.png', Astro.site).href;
const url = new URL(path, Astro.site).href;
const iso = (d) => { const t = new Date(d); return d && !isNaN(t) ? t.toISOString() : ''; };
const pubIso = iso(published), modIso = iso(modified);
const fullTitle = title === SITE_NAME ? `${SITE_NAME} | ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
const nav = [['home', '/', 'الرئيسية'], ['series', '/series/', 'المسلسلات'], ...(hasFilms ? [['films', '/films/', 'الأفلام']] : []), ['episodes', '/episodes/', 'الحلقات']];
const more = [...(TR.series.length + TR.films.length ? [['trending', '/trending/', 'الأكثر مشاهدة']] : []), ...(LD.tax.genres.length ? [['genres', '/genres/', 'الأنواع']] : []), ...(LD.tax.people.length ? [['people', '/people/', 'الممثلون والمخرجون']] : []), ...(hasUp ? [['ramadan', '/ramadan-2027/', 'رمضان 2027']] : [])];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="ar_AR" />
  {imgUrl && <meta property="og:image" content={imgUrl} />}
  {imgUrl && <meta property="og:image:alt" content={title} />}
  {type === 'article' && pubIso && <meta property="article:published_time" content={pubIso} />}
  {type === 'article' && modIso && <meta property="article:modified_time" content={modIso} />}
  <meta name="twitter:card" content={image ? 'summary' : 'summary_large_image'} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {imgUrl && <meta name="twitter:image" content={imgUrl} />}
  <link rel="alternate" hreflang="ar" href={url} />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
  <meta name="theme-color" content="#1c2140" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZXX1TDYBFL"></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}var _c=null;try{_c=localStorage.getItem('allcema-consent');}catch(e){}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:_c==='yes'?'granted':'denied',wait_for_update:500});gtag('js',new Date());gtag('config','G-ZXX1TDYBFL');</script>
  <slot name="head" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <header class="site-head"><div class="wrap">
    <a class="logo" href="/" aria-label={SITE_NAME}><i></i>{SITE_NAME}</a>
    <nav class="main-nav" aria-label="التنقل الرئيسي">{nav.map(([k, h, t]) => <a href={h} aria-current={active === k ? 'page' : undefined}>{t}</a>)}</nav>
    <div class="head-tools">
      <a class="icon-btn srch" href="/search/" aria-label="بحث في الموقع" aria-current={active === 'search' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg></a>
      <details class="menu"><summary class="icon-btn" aria-label="القائمة"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></summary>
        <nav class="menu-panel" aria-label="القائمة">{nav.map(([k, h, t]) => <a href={h} aria-current={active === k ? 'page' : undefined}>{t}</a>)}{more.length > 0 && <hr />}{more.map(([k, h, t]) => <a href={h} aria-current={active === k ? 'page' : undefined}>{t}</a>)}</nav>
      </details>
    </div>
  </div></header>
  <main><slot /></main>
  <footer class="site-foot"><div class="wrap">
    <div class="foot-grid">
      <div><b>{SITE_NAME}</b>{SITE_TAGLINE}. نكتب كل ملخص بصياغتنا، ونعتمد فيه على مصادر منشورة، ونضع تنبيه الحرق في أوله.</div>
      <nav aria-label="روابط التذييل"><b>الموقع</b><a href="/series/">المسلسلات</a>{hasFilms && <a href="/films/">الأفلام</a>}{LD.tax.people.length > 0 && <a href="/people/">الممثلون والمخرجون</a>}{LD.tax.genres.length > 0 && <a href="/genres/">الأنواع</a>}{hasUp && <a href="/ramadan-2027/">رمضان 2027</a>}<a href="/episodes/">الحلقات</a><a href="/about/">من نحن</a><a href="/privacy/">الخصوصية</a><a href="/copyright/">حقوق النشر</a><a href="/contact/">اتصل بنا</a><a href="/rss.xml">RSS</a></nav>
      {footSeries.length > 0 && <nav aria-label="المسلسلات"><b>المسلسلات</b>{footSeries.map((x) => <a href={x.path}>{x.title}</a>)}</nav>}
    </div>
    <small>{DISCLOSURE && <>{DISCLOSURE} </>}© {new Date().getFullYear()} {SITE_NAME}</small>
  </div></footer>
  <style is:inline>#cc{position:fixed;inset:auto 0 0 0;z-index:9999;background:#1c2140;color:#f1f2fa;padding:14px 16px;display:none;font:600 .92rem/1.7 'Noto Kufi Arabic','Segoe UI',Tahoma,sans-serif;box-shadow:0 -4px 18px rgba(0,0,0,.25)}#cc .in{max-width:980px;margin:0 auto;display:flex;gap:12px 18px;align-items:center;flex-wrap:wrap}#cc p{margin:0;flex:1 1 320px}#cc a{color:#fff;text-decoration:underline}#cc button{font:700 .92rem/1 'Noto Kufi Arabic','Segoe UI',Tahoma,sans-serif;padding:11px 20px;border-radius:5px;border:1px solid #7c84bd;background:transparent;color:#f1f2fa;cursor:pointer}#cc button.y{background:#d6245b;border-color:#d6245b;color:#fff}</style>
  <div id="cc" role="dialog" aria-label="إعدادات ملفات الارتباط"><div class="in"><p>نستخدم ملفات الارتباط لقياس زيارات الموقع وتحسين المحتوى. يمكنك القبول أو الرفض، والموقع يعمل في الحالتين. <a href="/privacy/">سياسة الخصوصية</a></p><div><button class="y" id="cc-y" type="button">أقبل</button> <button id="cc-n" type="button">أرفض</button></div></div></div>
  <script is:inline>(function(){var b=document.getElementById('cc'),s=null;try{s=localStorage.getItem('allcema-consent');}catch(e){}if(!b||s)return;b.style.display='block';function f(v){try{localStorage.setItem('allcema-consent',v);}catch(e){}if(v==='yes'&&window.gtag)gtag('consent','update',{analytics_storage:'granted'});b.style.display='none';}document.getElementById('cc-y').onclick=function(){f('yes');};document.getElementById('cc-n').onclick=function(){f('no');};})();</script>
</body>
</html>
