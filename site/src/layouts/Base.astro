---
import '@fontsource/noto-kufi-arabic/arabic-600.css';
import '@fontsource/noto-kufi-arabic/arabic-700.css';
import '@fontsource/noto-kufi-arabic/arabic-800.css';
import '@fontsource/noto-kufi-arabic/latin-800.css';
import '@fontsource/noto-naskh-arabic/arabic-400.css';
import '@fontsource/noto-naskh-arabic/arabic-600.css';
import '../styles/site.css';
import { SITE_NAME, SITE_TAGLINE, DISCLOSURE } from '../config.js';
import { load } from '../lib/data.js';
const LD = load();
const footSeries = LD.live.slice(0, 6);
const hasUp = LD.upcoming.length > 0;
const { title, description = SITE_TAGLINE, path = '/', schema = [], noindex = false, type = 'website', active = '', image = '' } = Astro.props;
const imgUrl = image ? new URL(image, Astro.site).href : '';
const url = new URL(path, Astro.site).href;
const fullTitle = title === SITE_NAME ? `${SITE_NAME} | ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
const nav = [['home', '/', 'الرئيسية'], ['series', '/series/', 'المسلسلات'], ['episodes', '/episodes/', 'الحلقات'], ['search', '/search/', 'بحث']];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="ar_AR" />
  {imgUrl && <meta property="og:image" content={imgUrl} />}
  <meta name="twitter:card" content={imgUrl ? 'summary_large_image' : 'summary'} />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
  <meta name="theme-color" content="#1c2140" />
  <slot name="head" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <header class="site-head"><div class="wrap">
    <a class="logo" href="/" aria-label={SITE_NAME}><i></i>{SITE_NAME}</a>
    <nav aria-label="التنقل الرئيسي">{nav.map(([k, h, t]) => <a href={h} aria-current={active === k ? 'page' : undefined}>{t}</a>)}</nav>
  </div></header>
  <main><slot /></main>
  <footer class="site-foot"><div class="wrap">
    <div class="foot-grid">
      <div><b>{SITE_NAME}</b>{SITE_TAGLINE}. نكتب كل ملخص بصياغتنا، ونعتمد فيه على مصادر منشورة، ونضع تنبيه الحرق في أوله.</div>
      <nav aria-label="روابط التذييل"><b>الموقع</b><a href="/series/">المسلسلات</a>{hasUp && <a href="/ramadan-2027/">رمضان 2027</a>}<a href="/episodes/">الحلقات</a><a href="/about/">من نحن</a><a href="/privacy/">الخصوصية</a><a href="/contact/">اتصل بنا</a><a href="/rss.xml">RSS</a></nav>
      {footSeries.length > 0 && <nav aria-label="المسلسلات"><b>المسلسلات</b>{footSeries.map((x) => <a href={x.path}>{x.title}</a>)}</nav>}
    </div>
    <small>{DISCLOSURE && <>{DISCLOSURE} </>}© {new Date().getFullYear()} {SITE_NAME}</small>
  </div></footer>
</body>
</html>
