---
import { SITE_NAME, SITE_TAGLINE, DISCLOSURE } from '../config.js';
const { title, description = SITE_TAGLINE, path = '/', schema = [], noindex = false, type = 'website' } = Astro.props;
const url = new URL(path, Astro.site).href;
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — ${SITE_TAGLINE}` : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="ar_AR" />
  <meta name="twitter:card" content="summary" />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
  <meta name="theme-color" content="#0f766e" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <style is:inline>
    :root{--bg:#fff;--fg:#1a1d21;--mute:#5b6470;--line:#e5e7eb;--brand:#0f766e;--card:#f7f8fa}
    @media (prefers-color-scheme:dark){:root{--bg:#0e1116;--fg:#e6e8eb;--mute:#9aa3af;--line:#252b33;--brand:#2dd4bf;--card:#151a21}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--fg);font:17px/1.85 system-ui,"Segoe UI",Tahoma,"Noto Naskh Arabic",sans-serif}
    a{color:var(--brand);text-decoration:none}a:hover{text-decoration:underline}
    .wrap{max-width:760px;margin:0 auto;padding:0 16px}
    header{border-bottom:1px solid var(--line)}
    header .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px}
    .logo{font-weight:800;font-size:1.25rem;color:var(--fg)}
    nav a{margin-inline-start:14px;color:var(--mute);font-size:.95rem}
    main{padding:24px 0 48px}
    h1{font-size:1.75rem;line-height:1.4;margin:.2em 0 .5em}
    h2{font-size:1.25rem;margin:1.6em 0 .5em}
    .crumbs{font-size:.88rem;color:var(--mute)}
    .meta{color:var(--mute);font-size:.9rem;margin:0 0 1em}
    table{width:100%;border-collapse:collapse;margin:.5em 0}
    th,td{text-align:start;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
    th{width:32%;color:var(--mute);font-weight:600}
    .grid{display:grid;gap:12px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
    .card h3{margin:0 0 4px;font-size:1.05rem;line-height:1.5}.card p{margin:0;color:var(--mute);font-size:.93rem}
    .pager{display:flex;justify-content:space-between;gap:12px;margin-top:2em}
    .note{font-size:.88rem;color:var(--mute);border:1px dashed var(--line);border-radius:10px;padding:10px 12px;margin-top:2em}
    footer{border-top:1px solid var(--line);color:var(--mute);font-size:.9rem;padding:20px 0}
    footer a{margin-inline-end:14px}
  </style>
</head>
<body>
  <header><div class="wrap">
    <a class="logo" href="/">{SITE_NAME}</a>
    <nav><a href="/">الرئيسية</a><a href="/about/">من نحن</a></nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer><div class="wrap">
    <a href="/about/">من نحن</a><a href="/privacy/">الخصوصية</a><a href="/contact/">اتصل بنا</a><a href="/rss.xml">RSS</a>
    {DISCLOSURE && <p>{DISCLOSURE}</p>}
    <p>© {new Date().getFullYear()} {SITE_NAME}</p>
  </div></footer>
</body>
</html>
