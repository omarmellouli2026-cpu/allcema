---
import Base from '../../layouts/Base.astro';
import { SITE_NAME, DISCLOSURE } from '../../config.js';
---
<Base title="من نحن" path="/about/" description={`تعرّف على ${SITE_NAME} وسياستنا التحريرية.`}>
  <h1>من نحن</h1>
  <p>{SITE_NAME} موقع عربي يقدّم ملخصات الحلقات وتعريفات الأفلام والمسلسلات الجديدة. نكتب المحتوى بصياغتنا ونتحقق من أحداث كل حلقة من أكثر من مصدر قبل نشرها، ولا ننشر ما لا نستطيع تأكيده.</p>
  <h2>سياستنا التحريرية</h2>
  <ul><li>كل ملخص يحمل تنبيه حرق واضحًا.</li><li>لا ننسخ نصوص المواقع الأخرى.</li><li>نصحّح الأخطاء عند الإبلاغ عنها عبر صفحة «اتصل بنا».</li></ul>
  {DISCLOSURE && <p>{DISCLOSURE}</p>}
</Base>
