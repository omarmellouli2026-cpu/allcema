---
import Base from '../../layouts/Base.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../../config.js';
const real = CONTACT_EMAIL && !/example\.com$/.test(CONTACT_EMAIL);
---
<Base title="حقوق النشر والإبلاغ" path="/copyright/" description={`سياسة حقوق النشر في ${SITE_NAME} وطريقة طلب إزالة صورة أو نص.`}>
  <section class="band page-head"><div class="wrap"><nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>حقوق النشر</nav><h1>حقوق النشر والإبلاغ</h1></div></section>
  <div class="wrap"><div class="plain prose">
    <h2>نصوصنا</h2>
    <p>ملخصات الحلقات والمقالات التعريفية في {SITE_NAME} مكتوبة بصياغتنا، ولا يجوز إعادة نشرها كاملة دون إذن. يمكنك الاقتباس القصير مع ذكر المصدر ورابط الصفحة.</p>

    <h2>الأعمال الفنية والصور</h2>
    <p>أسماء المسلسلات والأفلام وملصقاتها وصورها حقوقها لأصحابها، ونعرضها بترخيص وللتعريف بالأعمال فقط. لا ندّعي ملكيتها، وعلامة «{SITE_NAME}» على بعض الصور هي علامة موقعنا وليست دليل ملكية للصورة نفسها.</p>

    <h2>كيف تطلب إزالة محتوى</h2>
    <p>إن كنت صاحب حق أو ممثّله وترى أن محتوى على الموقع يخالف حقوقك، أرسل لنا:</p>
    <ul>
      <li>رابط الصفحة التي فيها المحتوى.</li>
      <li>وصف المحتوى وما يثبت أنك صاحب الحق أو مفوّض عنه.</li>
      <li>اسمك ووسيلة للتواصل معك.</li>
    </ul>
    {real
      ? <p>راسلنا على <a href={`mailto:${CONTACT_EMAIL}`} style="color:var(--sig);font-weight:600">{CONTACT_EMAIL}</a>. سنراجع الطلب ونزيل المحتوى المخالف دون تأخير.</p>
      : <p>راسلنا عبر صفحة «<a href="/contact/" style="color:var(--sig)">اتصل بنا</a>». سنراجع الطلب ونزيل المحتوى المخالف دون تأخير.</p>}

    <h2>الرسوم المولّدة بالذكاء الاصطناعي</h2>
    <p>بعض الأعمال التي لم يصدر لها ملصق رسمي نضع لها رسمًا توضيحيًا مولّدًا بالذكاء الاصطناعي، ونكتب ذلك تحت الصورة. هذه الرسوم ليست ملصقات رسمية.</p>
  </div></div>
</Base>
