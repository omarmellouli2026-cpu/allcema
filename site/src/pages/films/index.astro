---
import Base from '../../layouts/Base.astro';
import FilterGrid from '../../components/FilterGrid.astro';
import { load } from '../../lib/data.js';
const { films } = load();
const abs = (p) => new URL(p, Astro.site).href;
const schema = films.length ? [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'الأفلام المصرية', url: abs('/films/'), inLanguage: 'ar',
  mainEntity: { '@type': 'ItemList', itemListElement: films.slice(0, 100).map((m, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(m.path), name: m.title })) } }] : [];
---
<Base title="الأفلام المصرية الجديدة: القصة والأبطال" description="أفلام مصرية جديدة: القصة والأبطال وفريق العمل ومواعيد العرض على القنوات." path="/films/" active="films" schema={schema}>
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>الأفلام</nav>
    <h1>الأفلام المصرية</h1>
  </div></section>
  <div class="wrap">
    {films.length ? <FilterGrid works={films} sorts={[['new', 'الأحدث'], ['az', 'الأبجدي'], ['year', 'سنة الإنتاج']]} noun="فيلمًا" /> : <p class="empty">لا توجد أفلام منشورة بعد.</p>}
  </div>
</Base>
