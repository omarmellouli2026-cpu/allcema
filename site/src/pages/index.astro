---
import Base from '../layouts/Base.astro';
import EpRow from '../components/EpRow.astro';
import Tile from '../components/Tile.astro';
import { SITE_NAME, SITE_TAGLINE } from '../config.js';
import { load, desc } from '../lib/data.js';
const { live: series, episodes, upcoming, films } = load();
const top = episodes[0] || null;
// قائمة قصيرة: أحدث حلقة من كل مسلسل غير الظاهر في الأعلى، بحدّ أقصى 4
const others = episodes.slice(1);
const seenS = new Set(top ? [top.series.title] : []);
const rest = [];
for (const e of others) { if (!seenS.has(e.series.title)) { seenS.add(e.series.title); rest.push(e); } if (rest.length >= 4) break; }
for (const e of others) { if (rest.length >= 3) break; if (!rest.includes(e)) rest.push(e); }
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL('/', Astro.site).href, inLanguage: 'ar',
  potentialAction: { '@type': 'SearchAction', target: new URL('/search/?q={q}', Astro.site).href, 'query-input': 'required name=q' } }];
---
<Base title={SITE_NAME} description={SITE_TAGLINE} path="/" schema={schema} active="home">
  <section class="band hero"><div class="wrap hero-grid">
    <div>
      <h1>ماذا حدث في الحلقة؟ ملخص كل حلقة بعد عرضها</h1>
      <p class="lead">نتابع المسلسلات المعروضة ونكتب ما جرى في كل حلقة بأسلوبنا، مع تنبيه حرق واضح في أول كل ملخص.</p>
      {top && <a class="feature" href={top.path}>
        <b>مسلسل {top.series.title} حلقة {top.ep}</b>
        <span class="ex">{desc(top.excerpt, 170)}</span>
        <span class="btn">اقرأ ملخص الحلقة</span>
      </a>}
    </div>
    {top && <div class="num hero-num" aria-hidden="true">{top.numeral}<small>{top.series.title}</small></div>}
  </div></section>

  <div class="wrap">
    {rest.length > 0 && <section class="section">
      <div class="sec-head"><h2>آخر الحلقات</h2><a href="/episodes/">كل الحلقات</a></div>
      <ul class="ep-list compact">{rest.map((e) => <EpRow e={e} />)}</ul>
    </section>}
    {series.length > 0 && <section class="section">
      <div class="sec-head"><h2>المسلسلات</h2><a href="/series/">كل المسلسلات</a></div>
      <div class="tiles row">{series.slice(0, 5).map((s) => <Tile s={s} />)}</div>
    </section>}
    {films.length > 0 && <section class="section">
      <div class="sec-head"><h2>أفلام مصرية جديدة</h2><a href="/films/">كل الأفلام</a></div>
      <div class="tiles row">{films.slice(0, 5).map((m) => <Tile s={m} />)}</div>
    </section>}
    {upcoming.length > 0 && <a class="rmd" href="/ramadan-2027/">
      <div><b>رمضان 2027 قادم</b><span>{upcoming.length} مسلسلًا معلنًا حتى الآن، مع الأبطال وما نعرفه عن كل عمل.</span></div>
      <span class="btn">تصفّح المسلسلات المعلنة</span>
    </a>}
    {rest.length === 0 && series.length === 0 && films.length === 0 && <p class="empty">لم تُنشر ملخصات بعد. تعود الصفحة إلى العمل فور نشر أول حلقة.</p>}
  </div>
</Base>
