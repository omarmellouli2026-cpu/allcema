---
import Base from '../layouts/Base.astro';
import EpRow from '../components/EpRow.astro';
import Tile from '../components/Tile.astro';
import Poster from '../components/Poster.astro';
import { SITE_NAME } from '../config.js';
import { load, desc, trending } from '../lib/data.js';
const { live: series, episodes, upcoming, films, tax } = load();
const top = episodes[0] || null;
const TR = trending();
const hot = [...TR.series.slice(0, 3), ...TR.films.slice(0, 2)].map((e) => e.work);
// قائمة قصيرة: أحدث حلقة من كل مسلسل غير الظاهر في الأعلى، بحدّ أقصى 4
const others = episodes.slice(1);
const seenS = new Set(top ? [top.series.title] : []);
const rest = [];
for (const e of others) { if (!seenS.has(e.series.title)) { seenS.add(e.series.title); rest.push(e); } if (rest.length >= 4) break; }
for (const e of others) { if (rest.length >= 3) break; if (!rest.includes(e)) rest.push(e); }
const feat = top && top.series.image ? top.series : null;
const abs = (p) => new URL(p, Astro.site).href;
const cs = (s) => (s.facts.countries || []).map(String);
const isSa = (s) => cs(s).some((c) => c.includes('السعودية')) && !cs(s).some((c) => c.includes('مصر'));
const withImg = (a) => [...a].sort((x, y) => (y.image ? 1 : 0) - (x.image ? 1 : 0));
const egy = withImg(series.filter((s) => !isSa(s))), sau = withImg(series.filter(isSa));
const saC = tax.countryBy && tax.countryBy.get('السعودية');
const saLink = saC ? `/countries/${saC.slug}/` : '/series/';
const kpis = [[series.length, 'مسلسلًا'], [films.length, 'فيلمًا'], [episodes.length, 'ملخص حلقة'], [tax.people.length, 'ممثلًا ومخرجًا']].filter((k) => k[0] > 0);
const topGenres = tax.genres.slice(0, 8), topPeople = tax.people.slice(0, 12);
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: abs('/'), inLanguage: 'ar',
    potentialAction: { '@type': 'SearchAction', target: abs('/search/?q={q}'), 'query-input': 'required name=q' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE_NAME, url: abs('/') },
  ...(series.length ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'مسلسلات مصرية', itemListElement: series.slice(0, 10).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(s.path), name: s.title })) }] : []),
];
---
<Base title="ملخصات الحلقات والمسلسلات والأفلام المصرية الجديدة" description="اقرأ ملخص كل حلقة من المسلسلات المصرية بعد عرضها، وتعرّف على قصة المسلسلات والأفلام الجديدة وأبطالها ومواعيد عرضها على Allcema." path="/" schema={schema} active="home" image={feat ? feat.image : ''}>
  <section class="band hero"><div class="wrap hero-grid">
    <div>
      <span class="eyebrow">مسلسلات وأفلام مصرية</span>
      <h1>ملخصات المسلسلات المصرية وأخبار الأفلام الجديدة</h1>
      <p class="lead">نكتب ما جرى في كل حلقة بعد عرضها، ونعرّفك بقصة كل مسلسل وفيلم وأبطاله، مع تنبيه حرق واضح في أول كل ملخص.</p>
      <form class="hsearch" action="/search/" method="get" role="search">
        <input type="search" name="q" placeholder="ابحث عن مسلسل أو فيلم أو ممثل" aria-label="ابحث في الموقع" autocomplete="off" />
        <button type="submit">بحث</button>
      </form>
      {top && <a class="feature" href={top.path}>
        <b>مسلسل {top.series.title} حلقة {top.ep}</b>
        <span class="ex">{desc(top.excerpt, 170)}</span>
        <span class="btn">اقرأ ملخص الحلقة</span>
      </a>}
    </div>
    {feat ? <a class="hero-poster" href={feat.path} aria-label={`مسلسل ${feat.title}`}><Poster s={feat} eager alt={`ملصق مسلسل ${feat.title}`} /></a>
      : top && <div class="num hero-num" aria-hidden="true">{top.numeral}<small>{top.series.title}</small></div>}
  </div></section>

  <div class="wrap">
    {kpis.length > 0 && <div class="kpis">{kpis.map(([n, l]) => <div><b>{n}</b><span>{l}</span></div>)}</div>}
    {hot.length > 0 && <section class="section">
      <div class="sec-head"><h2>الأكثر مشاهدة اليوم</h2><a href="/trending/">الترتيب الكامل</a></div>
      <div class="tiles row">{hot.map((x) => <Tile s={x} />)}</div>
    </section>}
    {rest.length > 0 && <section class="section">
      <div class="sec-head"><h2>آخر الحلقات</h2><a href="/episodes/">كل الحلقات</a></div>
      <ul class="ep-list compact">{rest.map((e) => <EpRow e={e} />)}</ul>
    </section>}
    {egy.length > 0 && <section class="section" id="egy-series">
      <div class="sec-head"><h2>مسلسلات مصرية</h2><a href="/series/">كل المسلسلات</a></div>
      <div class="tiles row">{egy.slice(0, 10).map((s) => <Tile s={s} />)}</div>
    </section>}
    {sau.length > 0 && <section class="section" id="sa-series">
      <div class="sec-head"><h2>مسلسلات سعودية</h2><a href={saLink}>كل المسلسلات السعودية</a></div>
      <div class="tiles row">{sau.slice(0, 10).map((s) => <Tile s={s} />)}</div>
    </section>}
    {films.length > 0 && <section class="section">
      <div class="sec-head"><h2>أفلام مصرية جديدة</h2><a href="/films/">كل الأفلام</a></div>
      <div class="tiles row">{films.slice(0, 5).map((m) => <Tile s={m} />)}</div>
    </section>}
    {(topGenres.length > 0 || topPeople.length > 0) && <section class="section explore">
      {topGenres.length > 0 && <div>
        <div class="sec-head"><h2>تصفّح حسب النوع</h2><a href="/genres/">كل الأنواع</a></div>
        <div class="chips">{topGenres.map((g) => <a class="chip" href={`/genres/${g.slug}/`}>{g.name}<small>{g.count}</small></a>)}</div>
      </div>}
      {topPeople.length > 0 && <div>
        <div class="sec-head"><h2>الأكثر حضورًا</h2><a href="/people/">كل الأسماء</a></div>
        <div class="chips">{topPeople.map((p) => <a class="chip" href={`/people/${p.slug}/`}>{p.name}<small>{p.count}</small></a>)}</div>
      </div>}
    </section>}
    {upcoming.length > 0 && <a class="rmd" href="/ramadan-2027/">
      <div><b>رمضان 2027 قادم</b><span>{upcoming.length} مسلسلًا معلنًا حتى الآن، مع الأبطال وما نعرفه عن كل عمل.</span></div>
      <span class="btn">تصفّح المسلسلات المعلنة</span>
    </a>}
    {(series.length > 0 || films.length > 0) && <section class="about-home">
      <h2>عن Allcema</h2>
      <p>Allcema موقع عربي يتابع <a href="/series/">المسلسلات المصرية</a> و<a href="/films/">الأفلام المصرية</a> الجديدة. لكل عمل صفحة تضم القصة والأبطال وفريق العمل، ونكتب لكل حلقة ملخصًا بصياغتنا بعد عرضها. يمكنك أيضًا التنقل بين <a href="/people/">الممثلين والمخرجين</a> و<a href="/genres/">الأنواع</a> للوصول إلى ما يناسبك.</p>
    </section>}
    {rest.length === 0 && series.length === 0 && films.length === 0 && <p class="empty">لم تُنشر ملخصات بعد. تعود الصفحة إلى العمل فور نشر أول حلقة.</p>}
  </div>
</Base>
