---
import Base from '../layouts/Base.astro';
import EpRow from '../components/EpRow.astro';
import Tile from '../components/Tile.astro';
import { SITE_NAME, SITE_TAGLINE } from '../config.js';
import { load, desc } from '../lib/data.js';
const { series, episodes } = load();
const top = episodes[0] || null;
const rest = episodes.slice(0, 6);
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL('/', Astro.site).href, inLanguage: 'ar',
  potentialAction: { '@type': 'SearchAction', target: new URL('/search/?q={q}', Astro.site).href, 'query-input': 'required name=q' } }];
---
<Base title={SITE_NAME} description={SITE_TAGLINE} path="/" schema={schema} active="home">
  <section class="band hero"><div class="wrap hero-grid">
    <div>
      <h1>ماذا حدث في الحلقة؟ ملخص كل حلقة بعد عرضها</h1>
      <p class="lead">نتابع المسلسلات المعروضة ونكتب ما جرى في كل حلقة بأسلوبنا، مع تنبيه حرق واضح في أول كل ملخص.</p>
      {top && <a class="feature" href={top.path}>
        <b>مسلسل {top.series.title} حلقة {top.ep}</b>
        <span class="ex">{desc(top.excerpt, 220)}</span>
        <span class="btn">اقرأ ملخص الحلقة</span>
      </a>}
    </div>
    {top && <div class="num hero-num" aria-hidden="true">{top.numeral}<small>{top.series.title}</small></div>}
  </div></section>

  {rest.length > 0 ? <div class="wrap">
    <section class="section">
      <div class="sec-head"><h2>آخر الحلقات</h2><a href="/episodes/">كل الحلقات</a></div>
      <ul class="ep-list">{rest.map((e) => <EpRow e={e} />)}</ul>
    </section>
    <section class="section">
      <div class="sec-head"><h2>المسلسلات</h2><a href="/series/">كل المسلسلات</a></div>
      <div class="tiles">{series.slice(0, 6).map((s) => <Tile s={s} />)}</div>
    </section>
  </div> : <div class="wrap"><p class="empty">لم تُنشر ملخصات بعد. تعود الصفحة إلى العمل فور نشر أول حلقة.</p></div>}
</Base>
