---
import Base from '../../layouts/Base.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../../config.js';
const real = CONTACT_EMAIL && !/example\.com$/.test(CONTACT_EMAIL);
const mailLink = '<!--email_off--><a href="mailto:' + CONTACT_EMAIL + '" style="color:var(--sig);font-weight:600">' + CONTACT_EMAIL + '</a><!--/email_off-->';
---
<Base title="سياسة الخصوصية" path="/privacy/" description={`سياسة الخصوصية وملفات الارتباط والإعلانات في ${SITE_NAME}: ما البيانات التي تُجمع، ومن يستخدمها، وكيف تتحكم بها.`}>
  <section class="band page-head"><div class="wrap"><nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>الخصوصية</nav><h1>سياسة الخصوصية</h1></div></section>
  <div class="wrap"><div class="plain prose">
    <p>آخر تحديث: 8 نوفمبر 2026. تشرح هذه الصفحة ما يحدث لبياناتك عند زيارة {SITE_NAME}.</p>

    <h2>ما الذي نجمعه</h2>
    <p>لا نطلب منك تسجيل حساب ولا نجمع اسمك أو بريدك لتتصفّح الموقع. عند الزيارة تُسجَّل تلقائيًا بيانات تقنية عامة لدى مزوّد الاستضافة، مثل عنوان IP ونوع المتصفح والصفحة المطلوبة والوقت، وذلك لتشغيل الموقع وحمايته من إساءة الاستخدام.</p>

    <h2>الإحصاءات</h2>
    <p>نستخدم أداة إحصاء من Cloudflare (Web Analytics) لمعرفة عدد الزيارات والصفحات الأكثر قراءة. هذه الأداة لا تستخدم ملفات تعريف ارتباط للتتبّع ولا تبني ملفًا شخصيًا عنك.</p>

    <h2>الإعلانات وملفات الارتباط</h2>
    <p>قد نعرض إعلانات من جهات خارجية، منها Google AdSense. هذه الجهات، ومنها Google، تستخدم ملفات تعريف الارتباط (كوكيز) أو معرّفات مشابهة لعرض إعلانات بناءً على زياراتك السابقة لهذا الموقع ومواقع أخرى، ولقياس أداء الإعلانات.</p>
    <ul>
      <li>تستخدم Google وشركاؤها ملفات الارتباط لعرض الإعلانات بحسب زياراتك لهذا الموقع و/أو مواقع أخرى على الإنترنت.</li>
      <li>يمكنك إيقاف الإعلانات المخصّصة من <a href="https://adssettings.google.com" style="color:var(--sig)" rel="noopener">إعدادات إعلانات Google</a>.</li>
      <li>يمكنك أيضًا رفض ملفات الارتباط لدى جهات إعلانية أخرى عبر <a href="https://www.aboutads.info/choices/" style="color:var(--sig)" rel="noopener">aboutads.info</a>.</li>
      <li>لمعرفة كيف تستخدم Google البيانات من المواقع الشريكة: <a href="https://policies.google.com/technologies/partner-sites" style="color:var(--sig)" rel="noopener">policies.google.com/technologies/partner-sites</a>.</li>
      <li>يمكنك حذف الكوكيز أو حظرها من إعدادات متصفحك، وقد يؤثر ذلك على عمل بعض مزايا المواقع.</li>
    </ul>

    <h2>زوّار الاتحاد الأوروبي والمملكة المتحدة وسويسرا</h2>
    <p>إذا كنت في هذه المناطق، فسنطلب موافقتك عبر أداة إدارة موافقة معتمدة قبل استخدام ملفات الارتباط الإعلانية، ويمكنك تغيير اختيارك في أي وقت. ولك حقوق في الاطلاع على بياناتك وتصحيحها وحذفها والاعتراض على معالجتها بحسب القانون المطبّق.</p>

    <h2>الروابط الخارجية</h2>
    <p>قد يحتوي الموقع على روابط لمواقع أخرى مثل دليل القنوات. لا نتحكم في سياسات الخصوصية لتلك المواقع، ننصحك بمراجعتها.</p>

    <h2>الأطفال</h2>
    <p>الموقع غير موجّه إلى الأطفال دون 13 عامًا، ولا نجمع عمدًا بيانات منهم.</p>

    <h2>التواصل</h2>
    {real
      ? <p>لأي استفسار عن بياناتك أو لطلب حذفها راسلنا على <Fragment set:html={mailLink} />.</p>
      : <p>لأي استفسار عن بياناتك أو لطلب حذفها راسلنا عبر صفحة «<a href="/contact/" style="color:var(--sig)">اتصل بنا</a>».</p>}
    <p>قد نحدّث هذه السياسة من وقت لآخر، ويظهر تاريخ آخر تحديث في أعلاها.</p>
  </div></div>
</Base>
