---
import Base from '../../layouts/Base.astro';
---
<Base title="بحث" description="ابحث عن مسلسل أو حلقة." path="/search/" noindex={true} active="search">
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>بحث</nav>
    <h1>ابحث عن مسلسل أو حلقة</h1>
  </div></section>
  <div class="wrap" style="padding-top:30px">
    <input id="q" class="search-box" type="search" placeholder="اكتب اسم المسلسل أو اسم شخصية" autocomplete="off" aria-label="بحث" />
    <ul id="out" class="ep-list" style="margin-top:22px"></ul>
    <p id="msg" class="empty" hidden></p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById('q'), out = document.getElementById('out'), msg = document.getElementById('msg'), data = null;
      var DIAC = new RegExp('[' + String.fromCharCode(1611) + '-' + String.fromCharCode(1631) + String.fromCharCode(1600) + ']', 'g');
      var norm = function (s) { return String(s || '').toLowerCase().replace(DIAC, '').replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي'); };
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      function render() {
        var v = norm(q.value).trim();
        out.innerHTML = ''; msg.hidden = true;
        if (!v || !data) return;
        var words = v.split(/\s+/);
        var hits = data.filter(function (r) { var h = norm(r.t + ' ' + (r.a || '') + ' ' + r.x); return words.every(function (w) { return h.indexOf(w) > -1; }); }).slice(0, 30);
        if (!hits.length) { msg.textContent = 'لا توجد نتائج. جرّب اسم المسلسل فقط.'; msg.hidden = false; return; }
        out.innerHTML = hits.map(function (r) {
          return '<li><a class="ep-row" href="' + esc(r.p) + '"><span class="num" aria-hidden="true">' + (r.n || '') + '</span><div><h3>' + esc(r.t) +
            '</h3><p>' + esc(r.x) + '</p></div><span></span></a></li>';
        }).join('');
      }
      q.addEventListener('input', render);
      var init = new URLSearchParams(location.search).get('q'); if (init) q.value = init;
      fetch('/search.json').then(function (r) { return r.json(); }).then(function (d) { data = d; render(); });
    })();
  </script>
</Base>
