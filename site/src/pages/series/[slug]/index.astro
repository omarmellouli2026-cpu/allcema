---
import Base from '../../../layouts/Base.astro';
import EpRow from '../../../components/EpRow.astro';
import Strip from '../../../components/Strip.astro';
import Poster from '../../../components/Poster.astro';
import Airings from '../../../components/Airings.astro';
import Related from '../../../components/Related.astro';
import Share from '../../../components/Share.astro';
import { load, joinAr, num, linkList, related, fmtDate, desc as clip } from '../../../lib/data.js';
export function getStaticPaths() {
  return load().series.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const f = s.facts;
const desc = [...s.episodes].reverse();
const rows = s.upcoming ? [['التصنيف', joinAr(f.genres)], ['بلد الإنتاج', joinAr(f.countries)], ['الإخراج', joinAr(f.directors)], ['التأليف', joinAr(f.writers)],
  ['البطولة', joinAr(f.cast)], ['اللغة', joinAr(f.languages)]].filter((r) => r[1]) :
  [['التصنيف', linkList('g', f.genres)], ['بلد الإنتاج', linkList('c', f.countries)], ['الإخراج', linkList('p', f.directors)], ['التأليف', linkList('p', f.writers)],
  ['البطولة', linkList('p', f.cast)], ['اللغة', joinAr(f.languages)]].filter((r) => r[1]);
const abs = (p) => new URL(p, Astro.site).href;
const schema = [{ '@context': 'https://schema.org', '@type': 'TVSeries', name: s.title, ...(s.alt ? { alternateName: s.alt } : {}), url: abs(s.path),
  description: clip(s.excerpt || s.blurb, 300), inLanguage: 'ar', ...(s.image ? { image: abs(s.image) } : {}),
  ...(f.year ? { datePublished: String(f.year) } : {}), ...(s.at && !s.upcoming ? { dateModified: String(s.at) } : {}),
  ...(s.count ? { numberOfEpisodes: s.count } : {}), ...(f.genres?.length ? { genre: f.genres } : {}),
  ...(f.countries?.length ? { countryOfOrigin: f.countries.map((n) => ({ '@type': 'Country', name: n })) } : {}),
  ...(f.cast?.length ? { actor: f.cast.map((n) => ({ '@type': 'Person', name: n })) } : {}),
  ...(f.directors?.length ? { director: f.directors.map((n) => ({ '@type': 'Person', name: n })) } : {}),
  ...(s.count ? { episode: s.episodes.slice(-50).map((e) => ({ '@type': 'TVEpisode', episodeNumber: e.ep, name: `الحلقة ${e.ep}`, url: abs(e.path) })) } : {}) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: abs('/') }, { '@type': 'ListItem', position: 2, name: 'المسلسلات', item: abs('/series/') },
    { '@type': 'ListItem', position: 3, name: s.title, item: abs(s.path) }] }];
if (!s.upcoming && s.article?.faq?.length) schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.article.faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) });
---
<Base title={s.upcoming ? `مسلسل ${s.title} رمضان ${f.year}: ما نعرفه حتى الآن` : `مسلسل ${s.title}${f.year ? ' ' + f.year : ''}: القصة والأبطال وملخصات الحلقات`} description={clip(s.excerpt || s.blurb, 160)} path={s.path} schema={schema} active="series" type={s.upcoming ? 'website' : 'video.tv_show'} image={s.image} noindex={s.noindex}>
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span><a href="/series/">المسلسلات</a><span>/</span>{s.title}</nav>
    <div class="ph-grid">
      <div>
        <h1>مسلسل {s.title}</h1>
        {s.alt && <div class="alt" lang="en">{s.alt}</div>}
        <ul class="facts">{[f.kind, f.year, joinAr(f.countries), f.genres?.[0]].filter(Boolean).map((x) => <li>{x}</li>)}</ul>
        {s.count > 0 && s.at && <div class="meta-line"><span>آخر تحديث:</span><time datetime={String(s.at).slice(0, 10)}>{fmtDate(s.at)}</time></div>}
        {s.latest && <div class="ph-actions"><a class="btn" href={s.latest.path}>اقرأ ملخص الحلقة {s.latest.ep}</a>{s.count > 1 && <a class="btn ghost" href={s.episodes[0].path}>ابدأ من الحلقة {s.episodes[0].ep}</a>}</div>}
        {!s.upcoming && <Share path={s.path} title={`مسلسل ${s.title}: ملخصات الحلقات`} />}
      </div>
      <div class="ph-poster"><Poster s={s} eager alt={s.art ? `رسم توضيحي لمسلسل ${s.title}` : `ملصق مسلسل ${s.title}`} />{s.image && <p class="img-cap">{s.art ? 'رسم توضيحي بالذكاء الاصطناعي مستوحى من اسم المسلسل، وليس الملصق الرسمي.' : 'ملصق المسلسل، منشور بإذن من الجهة المالكة.'}</p>}</div>
    </div>
    {s.count > 0 && <Strip eps={s.episodes} />}
  </div></section>
  <div class="wrap ep-layout">
    <div>
      {s.article && <article class="prose" style="margin-bottom:34px">
        <div class="lede" set:html={s.article.lead} />
        {s.article.sections.map((x) => <><h2>{x.title}</h2><div set:html={x.html} /></>)}
        {s.article.faq.length > 0 && <section class="faq"><h2>أسئلة شائعة</h2>{s.article.faq.map((x) => <><h3>{x.q}</h3><p>{x.a}</p></>)}</section>}
      </article>}
      {(s.count || !s.article) && <div class="sec-head"><h2>ملخصات الحلقات{s.count ? ` (${num(s.count)})` : ''}</h2></div>}
      {s.count ? <ul class="ep-list">{desc.map((e) => <EpRow e={e} showSeries={false} />)}</ul> : (s.article ? null : <p class="empty">{s.upcoming ? `المسلسل من أعمال رمضان ${f.year} المعلنة ولم يبدأ عرضه بعد. ننشر ملخص كل حلقة بعد عرضها.` : 'لا توجد ملخصات منشورة لهذا المسلسل بعد.'}</p>)}
    </div>
    <aside>
      <div class="box"><h2>عن المسلسل</h2><p style="margin:0 0 10px;font-size:.97rem;line-height:1.9">{s.blurb}</p>
        <dl class="card">{rows.map(([k, v]) => <div><dt>{k}</dt><dd set:html={v} /></div>)}</dl>{s.upcoming && <p class="img-cap">المعلومات من تقارير صحفية منشورة عن أعمال رمضان {f.year}، وقد تتغير قبل العرض.</p>}</div>
      {!s.upcoming && <Airings f={f} />}
    </aside>
  </div>
  {!s.upcoming && <Related list={related(s, 4)} />}
</Base>
