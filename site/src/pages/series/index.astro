---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { load } from '../../lib/data.js';
const { series } = load();
---
<Base title="المسلسلات" description="المسلسلات التي نكتب ملخصات حلقاتها، مرتبة بحسب آخر حلقة." path="/series/" active="series">
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>المسلسلات</nav>
    <h1>المسلسلات</h1>
  </div></section>
  <div class="wrap">
    {series.length ? <div class="tiles" style="margin-top:34px">{series.map((s) => <Tile s={s} />)}</div> : <p class="empty">لا توجد مسلسلات منشورة بعد.</p>}
  </div>
</Base>
