---
import Base from '../../layouts/Base.astro';
import FilterGrid from '../../components/FilterGrid.astro';
import Tile from '../../components/Tile.astro';
import { load } from '../../lib/data.js';
const { live: allSeries } = load();
const cs = (s) => (s.facts.countries || []).map(String);
const isEg = (s) => cs(s).length === 0 || cs(s).some((c) => c.includes('مصر'));
const isSa = (s) => !isEg(s) && cs(s).some((c) => c.includes('السعودية'));
const series = allSeries.filter(isEg), saudi = allSeries.filter(isSa), other = allSeries.filter((s) => !isEg(s) && !isSa(s));
const abs = (p) => new URL(p, Astro.site).href;
const schema = series.length ? [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'المسلسلات المصرية', url: abs('/series/'), inLanguage: 'ar',
  mainEntity: { '@type': 'ItemList', itemListElement: series.slice(0, 100).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(s.path), name: s.title })) } }] : [];
---
<Base title="المسلسلات المصرية: ملخصات الحلقات والأبطال" description="المسلسلات المصرية التي نكتب ملخصات حلقاتها: قصة كل مسلسل وأبطاله وفريق عمله وكل حلقة بعد عرضها، مرتبة بحسب آخر حلقة." path="/series/" active="series" schema={schema}>
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>المسلسلات</nav>
    <h1>المسلسلات المصرية</h1>
  </div></section>
  <div class="wrap">
    {series.length ? <FilterGrid works={series} sorts={[['new', 'الأحدث حلقة'], ['az', 'الأبجدي'], ['year', 'سنة الإنتاج']]} noun="مسلسلًا" /> : <p class="empty">لا توجد مسلسلات منشورة بعد.</p>}
    {saudi.length > 0 && <section class="section" id="saudi-series">
      <div class="sec-head"><h2>مسلسلات سعودية</h2></div>
      <div class="tiles">{saudi.map((s) => <Tile s={s} />)}</div>
    </section>}
    {other.length > 0 && <section class="section" id="other-series">
      <div class="sec-head"><h2>مسلسلات تركية وأجنبية</h2></div>
      <div class="tiles">{other.map((s) => <Tile s={s} />)}</div>
    </section>}
  </div>
</Base>
