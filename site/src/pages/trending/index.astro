---
import Base from '../../layouts/Base.astro';
import Poster from '../../components/Poster.astro';
import { trending, fmtDate } from '../../lib/data.js';
const T = trending();
const has = T.series.length + T.films.length > 0;
const abs = (x) => new URL(x, Astro.site).href;
const all = [...T.series, ...T.films];
const schema = [
  ...(has ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'الأكثر مشاهدة وبحثًا اليوم',
    itemListElement: all.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(e.work.path), name: e.work.title })) }] : []),
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: abs('/') }, { '@type': 'ListItem', position: 2, name: 'الأكثر مشاهدة', item: abs('/trending/') }] }];
const blocks = [['المسلسلات الأكثر مشاهدة وبحثًا', T.series], ['الأفلام الأكثر مشاهدة وبحثًا', T.films]].filter((b) => b[1].length);
---
<Base title="الأكثر مشاهدة: ترتيب المسلسلات والأفلام المصرية اليوم" description="ترتيب يومي للمسلسلات والأفلام المصرية الأكثر بحثًا ومشاهدة على الويب، مع رابط لقصة كل عمل وأبطاله وملخصات حلقاته." path="/trending/" schema={schema} active="trending" noindex={!has}>
  <section class="band page-head"><div class="wrap">
    <nav class="crumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span>/</span>الأكثر مشاهدة</nav>
    <h1>الأكثر مشاهدة وبحثًا اليوم</h1>
    {T.date && <div class="meta-line"><span>آخر تحديث:</span><time datetime={T.date}>{fmtDate(T.date)}</time></div>}
  </div></section>
  <div class="wrap">
    <p class="plain" style="max-width:760px;margin:22px 0 4px;color:var(--mute);font-size:.98rem">ترتيب يومي تقديري للأعمال المصرية الأكثر بحثًا وتداولًا على الويب، نجمعه آليًا من نتائج البحث، وليس إحصاء رسميًا لعدد المشاهدات. نضيف الأعمال الجديدة إلى الموقع تلقائيًا كلما ظهرت في هذا الترتيب.</p>
    {blocks.map(([title, list]) => <section class="section">
      <div class="sec-head"><h2>{title}</h2></div>
      <ul class="ep-list">{list.map((e, i) => <li><a class="ep-row" href={e.work.path}>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <span class="tr-thumb" style="width:64px;flex:none;display:block"><Poster s={e.work} alt={`ملصق ${e.work.isFilm ? 'فيلم' : 'مسلسل'} ${e.work.title}`} /></span>
        <div><h3>{e.work.isFilm ? 'فيلم' : 'مسلسل'} {e.work.title}</h3>{e.why && <p>{e.why}</p>}</div>
        <span class="mute">{e.work.facts.year || ''}</span>
      </a></li>)}</ul>
    </section>)}
    {!has && <p class="empty">يُحدَّث الترتيب كل يوم، وسيظهر هنا بعد أول تحديث.</p>}
  </div>
</Base>
<style>
  .ep-list .ep-row{display:flex;align-items:center;gap:16px}
  .ep-list .ep-row>div{flex:1;min-width:0}
  .ep-list .ep-row .tr-thumb{order:0}
  .ep-list .ep-row .tr-thumb .poster{width:100%}
</style>
