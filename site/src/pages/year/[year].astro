---
import Base from '../../layouts/Base.astro';
import { load, desc } from '../../lib/data.js';
export function getStaticPaths() {
  const { works, years } = load();
  return years.map((y) => ({ params: { year: String(y) }, props: { list: works.filter((w) => w.facts.year === y) } }));
}
const { year } = Astro.params; const { list } = Astro.props;
---
<Base title={`أعمال ${year}`} description={`أفلام ومسلسلات ${year} مع ملخصات وأخبار.`} path={`/year/${year}/`}>
  <h1>أعمال {year}</h1>
  <div class="grid">{list.map((w) => <a class="card" href={w.path}><h3>{w.title}</h3><p>{desc(w.excerpt, 110)}</p></a>)}</div>
</Base>
